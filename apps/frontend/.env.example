# URL pública da API. Em desenvolvimento aponta para o backend local; no
# Vercel, para o domínio onde o backend está hospedado.
#
# ATENÇÃO: se esta variável faltar, o BUILD FALHA (lib/env.ts valida na
# importação). É proposital — melhor quebrar no build do que publicar um site
# que não conversa com a API.
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# true  = usa dados de exemplo embutidos e não precisa de backend, mas o
#         cadastro e a conclusão de tarefas NÃO funcionam.
# false = conversa com a API de verdade.
NEXT_PUBLIC_USE_MOCKS=true

NEXT_PUBLIC_API_TIMEOUT=30000
