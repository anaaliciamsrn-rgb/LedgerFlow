# Ambiente. Em `production` o processo se RECUSA a subir com AUTH_MODE=stub
# ou sem CORS_ORIGINS — ver src/config/env.validation.ts.
NODE_ENV=development
PORT=3333

# stub = contexto de auth via headers/env. O tenant vem do header
#        x-tenant-id, então quem souber a URL lê qualquer escritório.
#        Aceitável em desenvolvimento; barrado em produção.
# jwt  = validação real do token (ainda não implementado).
AUTH_MODE=stub

# PostgreSQL — obrigatório, inclusive para desenvolver e rodar os testes.
# O banco em arquivo foi abandonado: ele não sobrevive a uma hospedagem, e os
# dados do cliente sumiriam a cada deploy.
#
# Sem Postgres instalado, um banco gerenciado gratuito resolve (Neon, Supabase).
# Use bancos DIFERENTES para desenvolver e para testar: a suíte apaga as
# tabelas entre os testes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledgerflow_dev"

BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# Domínios autorizados a chamar a API, separados por vírgula.
# Vazio é aceito em desenvolvimento; obrigatório em produção.
# Ex.: https://seu-app.vercel.app,https://app.escritorio.com.br
CORS_ORIGINS=

# Fallback do contexto de auth em modo stub (ids fixos criados pelo seed)
STUB_TENANT_ID=tnt_dev
STUB_USER_ID=usr_dev
STUB_ROLE=owner
