NODE_ENV=development
PORT=3333
# stub = contexto de auth via headers/env (dev); jwt = valida o cookie real da Infra
AUTH_MODE=stub
# SQLite local para dev/testes do Core. Troca para a URL do Postgres da Infra quando entregar.
DATABASE_URL="file:./dev.db"
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
# Fallback do contexto de auth em modo stub (ids fixos criados pelo seed)
STUB_TENANT_ID=tnt_dev
STUB_USER_ID=usr_dev
STUB_ROLE=owner
