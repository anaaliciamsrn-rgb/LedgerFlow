# Ambiente. Em `production` o processo se RECUSA a subir com AUTH_MODE=stub
# ou sem CORS_ORIGINS — ver src/config/env.validation.ts.
NODE_ENV=development
PORT=3333

# stub = contexto de auth via headers/env (só desenvolvimento: o tenant vem do
#        header x-tenant-id, então qualquer um leria qualquer escritório)
# jwt  = valida o token real — obrigatório em produção
AUTH_MODE=stub

# SQLite local para dev/testes. Em produção, Postgres:
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
DATABASE_URL="file:./dev.db"

BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# Domínios autorizados a chamar a API, separados por vírgula.
# Vazio é aceito em desenvolvimento; obrigatório em produção.
# Ex.: https://seu-app.vercel.app,https://app.escritorio.com.br
CORS_ORIGINS=

# Fallback do contexto de auth em modo stub (ids fixos criados pelo seed)
STUB_TENANT_ID=tnt_dev
STUB_USER_ID=usr_dev
STUB_ROLE=owner
