// Prisma schema — Core do Backend (LedgerFlow)
//
// Provider = sqlite apenas para dev/testes do Core (sem Docker/Postgres ainda).
// Quando a frente de Infra entregar o Postgres, trocar `provider` para
// "postgresql" e o DATABASE_URL. As queries do Core são portáveis (sem SQL
// específico de Postgres — RLS/policies são responsabilidade da Infra).
//
// Enums são modelados como String porque o SQLite não suporta enums no Prisma.
// A validação dos valores é feita na camada de aplicação (Zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Infra-owned (stub para o Core rodar isolado; a versão real —
// com auth, RLS e roles — é da frente de Infra/DB/Auth).
// ─────────────────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique

  // White label (spec §4.6): fonte de dados para `buildTenantCssVariables`.
  logoUrl      String?
  primaryColor String @default("221 83% 53%")
  accentColor  String @default("214 100% 97%")

  createdAt DateTime @default(now())

  companies    Company[]
  activityLogs ActivityLog[]
  auditRuns    AuditRun[]
  obligations  Obligation[]
}

// ─────────────────────────────────────────────────────────────
// Core-owned
// ─────────────────────────────────────────────────────────────
model Company {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // razão social
  tradeName   String   // nome fantasia
  cnpj        String

  // `status` = status INTERNO do escritório (controle do usuário).
  // NÃO confundir com `situacaoCadastral`, que é a situação OFICIAL na
  // Receita Federal. Foi essa confusão que fez a versão anterior descartar
  // o dado que o cliente pediu. Os dois campos são DIFERENTES e ambos
  // permanecem no modelo.
  status String @default("pending") // active | inactive | pending

  situacaoCadastral String    @default("") // ATIVA | SUSPENSA | INAPTA | BAIXADA | NULA
  cnaeCodigo        String    @default("")
  cnaeDescricao     String    @default("")
  porte             String    @default("") // MEI | ME | EPP | DEMAIS
  naturezaJuridica  String?
  dataAbertura      DateTime?

  email       String
  phone       String
  logradouro  String  @default("")
  numero      String  @default("")
  complemento String?
  bairro      String  @default("")
  cep         String  @default("")
  city        String
  state       String

  healthScore Int      @default(100) // score da auditoria
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partners    Partner[]
  auditRuns   AuditRun[]
  obligations Obligation[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@index([tenantId, state])
  @@index([tenantId, porte])
  @@index([tenantId, situacaoCadastral])
  @@index([tenantId, cnaeCodigo])
}

/// Quadro societário (QSA) vindo da BrasilAPI.
model Partner {
  id           String  @id @default(cuid())
  companyId    String
  nome         String
  qualificacao String
  faixaEtaria  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Obligation {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  title     String
  type      String // ex.: DAS, DCTF, GFIP, FGTS
  dueDate   DateTime
  status    String   @default("pending") // pending | completed

  assignee          String  @default("")
  recurrenceGroupId String?

  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([tenantId, dueDate])
  @@index([tenantId, assignee])
}

model AuditRun {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  score     Int
  status    String // healthy | attention | critical
  createdAt DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  findings AuditFinding[]

  @@index([tenantId, createdAt])
  @@index([companyId])
}

model AuditFinding {
  id         String  @id @default(cuid())
  auditRunId String
  code       String
  severity   String // info | warning | critical
  message    String
  result     String // passed | failed | skipped
  detail     String?

  auditRun AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@index([auditRunId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String
  action     String // ex.: company.created, company.updated, company.deleted
  entityType String // ex.: company
  entityId   String
  metadata   String? // JSON serializado (diffs, contexto)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
